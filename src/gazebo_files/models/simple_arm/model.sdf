<?xml ve      <inertial>
        <mass>10.0</mass>ion="1.0"?>
<sdf version="1.7">
  <model name="simple_arm">
    <static>false</static>
    
    <!-- Base Link -->
    <link name="base_link">
      <pose>0 0 0.1 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.1</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.1</iyy>
          <iyz>0</iyz>
          <izz>0.1</izz>
        </inertia>
      </inertial>
      <visual name="base_visual">
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.2</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.8 1</ambient>
          <diffuse>0.2 0.2 0.8 1</diffuse>
        </material>
      </visual>
      <collision name="base_collision">
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.2</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <!-- Link 1 -->
    <link name="link1">
      <pose>0 0 0.3 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.05</iyy>
          <iyz>0</iyz>
          <izz>0.05</izz>
        </inertia>
      </inertial>
      <visual name="link1_visual">
        <geometry>
          <box>
            <size>0.05 0.05 0.2</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.2 0.2 1</ambient>
          <diffuse>0.8 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <collision name="link1_collision">
        <geometry>
          <box>
            <size>0.05 0.05 0.2</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- Link 2 -->
    <link name="link2">
      <pose>0 0 0.5 0 0 0</pose>
      <inertial>
        <mass>0.4</mass>
        <inertia>
          <ixx>0.04</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.04</iyy>
          <iyz>0</iyz>
          <izz>0.04</izz>
        </inertia>
      </inertial>
      <visual name="link2_visual">
        <geometry>
          <box>
            <size>0.04 0.04 0.15</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.8 0.2 1</ambient>
          <diffuse>0.2 0.8 0.2 1</diffuse>
        </material>
      </visual>
      <collision name="link2_collision">
        <geometry>
          <box>
            <size>0.04 0.04 0.15</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- Link 3 -->
    <link name="link3">
      <pose>0 0 0.65 0 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.03</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.03</iyy>
          <iyz>0</iyz>
          <izz>0.03</izz>
        </inertia>
      </inertial>
      <visual name="link3_visual">
        <geometry>
          <box>
            <size>0.03 0.03 0.1</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.2 1</ambient>
          <diffuse>0.8 0.8 0.2 1</diffuse>
        </material>
      </visual>
      <collision name="link3_collision">
        <geometry>
          <box>
            <size>0.03 0.03 0.1</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- End Effector/Gripper Base -->
    <link name="gripper_base">
      <pose>0 0 0.75 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.02</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.02</iyy>
          <iyz>0</iyz>
          <izz>0.02</izz>
        </inertia>
      </inertial>
      <visual name="gripper_base_visual">
        <geometry>
          <box>
            <size>0.06 0.06 0.05</size>
          </box>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
        </material>
      </visual>
      <collision name="gripper_base_collision">
        <geometry>
          <box>
            <size>0.06 0.06 0.05</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- Gripper Finger 1 -->
    <link name="gripper_finger1">
      <pose>0.03 0 0.78 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
      <visual name="gripper_finger1_visual">
        <geometry>
          <box>
            <size>0.02 0.01 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
      <collision name="gripper_finger1_collision">
        <geometry>
          <box>
            <size>0.02 0.01 0.04</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- Gripper Finger 2 -->
    <link name="gripper_finger2">
      <pose>-0.03 0 0.78 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
      <visual name="gripper_finger2_visual">
        <geometry>
          <box>
            <size>0.02 0.01 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
      <collision name="gripper_finger2_collision">
        <geometry>
          <box>
            <size>0.02 0.01 0.04</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- Joints -->
    <!-- Fixed joint: World to Base (Fixed to ground) -->
    <joint name="world_to_base" type="fixed">
      <parent>world</parent>
      <child>base_link</child>
      <pose>0 0 0 0 0 0</pose>
    </joint>
    
    <!-- Joint 1: Base to Link1 (Revolute Z) -->
    <joint name="joint1" type="revolute">
      <parent>base_link</parent>
      <child>link1</child>
      <pose>0 0 -0.1 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-3.14159</lower>
          <upper>3.14159</upper>
        </limit>
      </axis>
    </joint>

    <!-- Joint 2: Link1 to Link2 (Revolute Y) -->
    <joint name="joint2" type="revolute">
      <parent>link1</parent>
      <child>link2</child>
      <pose>0 0 -0.075 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-2.356</lower>
          <upper>2.356</upper>
        </limit>
      </axis>
    </joint>

    <!-- Joint 3: Link2 to Link3 (Revolute Y) -->
    <joint name="joint3" type="revolute">
      <parent>link2</parent>
      <child>link3</child>
      <pose>0 0 -0.075 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-2.356</lower>
          <upper>2.356</upper>
        </limit>
      </axis>
    </joint>

    <!-- Joint 4: Link3 to Gripper Base (Revolute Z) -->
    <joint name="joint4" type="revolute">
      <parent>link3</parent>
      <child>gripper_base</child>
      <pose>0 0 -0.05 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-2.356</lower>
          <upper>2.356</upper>
        </limit>
      </axis>
    </joint>

    <!-- Gripper Joints -->
    <joint name="gripper_joint1" type="prismatic">
      <parent>gripper_base</parent>
      <child>gripper_finger1</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>0.01</lower>
          <upper>0.05</upper>
        </limit>
      </axis>
    </joint>

    <joint name="gripper_joint2" type="prismatic">
      <parent>gripper_base</parent>
      <child>gripper_finger2</child>
      <axis>
        <xyz>-1 0 0</xyz>
        <limit>
          <lower>0.01</lower>
          <upper>0.05</upper>
        </limit>
      </axis>
    </joint>

    <!-- Gazebo Garden Joint Position Controller Plugin -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>joint1</joint_name>
      <topic>/model/simple_arm/joint/joint1/cmd_pos</topic>
      <p_gain>1000</p_gain>
      <i_gain>0</i_gain>
      <d_gain>100</d_gain>
    </plugin>
    
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>joint2</joint_name>
      <topic>/model/simple_arm/joint/joint2/cmd_pos</topic>
      <p_gain>1000</p_gain>
      <i_gain>0</i_gain>
      <d_gain>100</d_gain>
    </plugin>
    
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>joint3</joint_name>
      <topic>/model/simple_arm/joint/joint3/cmd_pos</topic>
      <p_gain>1000</p_gain>
      <i_gain>0</i_gain>
      <d_gain>100</d_gain>
    </plugin>
    
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>joint4</joint_name>
      <topic>/model/simple_arm/joint/joint4/cmd_pos</topic>
      <p_gain>1000</p_gain>
      <i_gain>0</i_gain>
      <d_gain>100</d_gain>
    </plugin>
    
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>gripper_joint1</joint_name>
      <topic>/model/simple_arm/joint/gripper_joint/cmd_pos</topic>
      <p_gain>1000</p_gain>
      <i_gain>0</i_gain>
      <d_gain>100</d_gain>
    </plugin>
    
    <!-- Joint State Publisher Plugin -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/model/simple_arm/joint_state</topic>
    </plugin>

  </model>
</sdf>
